    {
      "id": "w_seed_liu_2",
      "kind": "ci",
      "title": "凤栖梧·其二（伫倚危楼风细细）",
      "author": "柳永",
      "dynasty": "北宋",
      "cipai": "凤栖梧",
      "content": "伫倚危楼风细细，望极春愁，黯黯生天际。\n草色烟光残照里，无言谁会凭阑意。\n拟把疏狂图一醉，对酒当歌，强乐还无味。\n衣带渐宽终不悔，为伊消得人憔悴。",
      "background": "此阕即通行本《蝶恋花·伫倚危楼风细细》，为柳永最传诵的一阕。王国维《人间词话》以「衣带渐宽终不悔」为治学第二境。",
      "claims": [
        {
          "id": "cl_seed_liu_2_a",
          "kind": "verified",
          "text": "「凤栖梧」与「蝶恋花」同调异名，「伫倚危楼风细细」一首两处互见。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_liu_1",
              "book": "唐圭璋《全宋词》",
              "edition": "中华书局校订本（通行本）",
              "page": "卷次与页码待核实",
              "url": "https://ctext.org/wiki.pl?if=gb&chapter=762233",
              "note": "网络校对据「子夜星分站·宋柳永词全集·卷三」；正式引用前请核对纸本页码",
              "verified": "verified"
            },
            {
              "id": "ct_seed_ouyang_1",
              "book": "欧阳修《近体乐府》",
              "edition": "卷二（据网络整理本附案语，卷次待核实）",
              "page": "页码待核实",
              "url": "https://www.ziyexing.cn/shici/liuyong/liuyong_3.htm",
              "note": "案语称前二阕别见此书，需查原书确认",
              "verified": "pending"
            }
          ],
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        {
          "id": "cl_seed_liu_2_b",
          "kind": "verified",
          "text": "王国维《人间词话》以「衣带渐宽终不悔，为伊消得人憔悴」为成大事业、大学问的第二种境界。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_liu_1",
              "book": "唐圭璋《全宋词》",
              "edition": "中华书局校订本（通行本）",
              "page": "卷次与页码待核实",
              "url": "https://ctext.org/wiki.pl?if=gb&chapter=762233",
              "note": "网络校对据「子夜星分站·宋柳永词全集·卷三」；正式引用前请核对纸本页码",
              "verified": "verified"
            }
          ],
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        {
          "id": "cl_seed_liu_2_c",
          "kind": "pending",
          "text": "「草色烟光残照里」中的「草」一说为「芳」，异文情况待核校本。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_liu_1",
              "book": "唐圭璋《全宋词》",
              "edition": "中华书局校订本（通行本）",
              "page": "卷次与页码待核实",
              "url": "https://ctext.org/wiki.pl?if=gb&chapter=762233",
              "note": "网络校对据「子夜星分站·宋柳永词全集·卷三」；正式引用前请核对纸本页码",
              "verified": "verified"
            }
          ],
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        {
          "id": "cl_seed_liu_2_d",
          "kind": "pending",
          "text": "作于何年何地，文献无确说，待查。",
          "paragraph": -1,
