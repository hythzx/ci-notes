    {
      "id": "w_seed_liu_1",
      "kind": "ci",
      "title": "凤栖梧·其一（帘下清歌帘外宴）",
      "author": "柳永",
      "dynasty": "北宋",
      "cipai": "凤栖梧",
      "content": "帘下清歌帘外宴，虽爱新声，不见如花面。\n牙板数敲珠一串，梁尘暗落琉璃盏。\n桐树花深孤凤怨，渐遏遥天，不放行云散。\n坐上少年听不惯，玉山未倒肠先断。",
      "background": "柳永（约984—约1053），字耆卿，北宋词人。本阕属《凤栖梧》调，又名《蝶恋花》，双调四十字。",
      "claims": [
        {
          "id": "cl_seed_liu_1_a",
          "kind": "verified",
          "text": "原文依《全宋词》通行本整理，「牙板数敲珠一串」句各本无异文。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_liu_1",
              "book": "唐圭璋《全宋词》",
              "edition": "中华书局校订本（通行本）",
              "page": "卷次与页码待核实",
              "url": "https://ctext.org/wiki.pl?if=gb&chapter=762233",
              "note": "网络校对据「子夜星分站·宋柳永词全集·卷三」；正式引用前请核对纸本页码",
              "verified": "verified"
            }
          ],
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        {
          "id": "cl_seed_liu_1_b",
          "kind": "pending",
          "text": "此阕的具体系年与作地点尚无定论，待查年谱。",
