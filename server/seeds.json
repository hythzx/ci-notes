    {
      "id": "w_seed_zhou_1",
      "kind": "ci",
      "title": "浣溪沙·楼上晴天碧四垂",
      "author": "周邦彦",
      "dynasty": "北宋",
      "cipai": "浣溪沙",
      "content": "楼上晴天碧四垂，楼前芳草接天涯。劝君莫上最高梯。\n新笋已成堂下竹，落花都上燕巢泥。忍听林表杜鹃啼。",
      "background": "周邦彦（1056—1121），字美成，号清真居士，钱塘人。词作多写羁旅与身世，格律谨严，自号「词家之冠」。",
      "claims": [
        {
          "id": "cl_seed_zhou_1_a",
          "kind": "verified",
          "text": "《浣溪沙》双调四十二字，本篇双调四十二字，字数与格律相合。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_zhou_1",
              "book": "唐圭璋《全宋词》",
              "edition": "中华书局校订本（通行本）",
              "page": "卷次与页码待核实",
              "url": "https://baike.baidu.com/item/%E6%B5%A3%E6%BA%AA%E6%B2%99-%E6%A5%BC%E4%B8%8A%E6%99%B4%E5%A4%A9%E7%A2%91%E5%9B%9B%E5%9E%82",
              "note": "词话注释参《宋词鉴赏辞典》一类工具书，具体页码待核实",
              "verified": "verified"
            }
          ],
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        {
          "id": "cl_seed_zhou_1_b",
          "kind": "verified",
          "text": "「劝君莫上最高梯」句反用王之涣「更上一层楼」；「芳草接天涯」正用古乐府「青青河边草，绵绵思远道」。",
