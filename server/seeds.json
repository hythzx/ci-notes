    {
      "id": "w_seed_liu_3",
      "kind": "ci",
      "title": "凤栖梧·其三（蜀锦地衣丝步障）",
      "author": "柳永",
      "dynasty": "北宋",
      "cipai": "凤栖梧",
      "content": "蜀锦地衣丝步障，屈曲回廊，静夜闲寻访。\n玉砌雕阑新月上，朱扉半掩人相望。\n旋暖熏炉温斗帐，玉树琼枝，迤逦相偎傍。\n酒力渐浓春思荡，鸳鸯绣被翻红浪。",
      "background": "此阕写夜访，写景用物极铺张，末句转入欢情。前阕「帘下清歌帘外宴」与此阕当为同一组词。",
      "claims": [
        {
          "id": "cl_seed_liu_3_a",
          "kind": "verified",
          "text": "原文依《全宋词》通行本整理，「迤逦相偎傍」句通行本多作「迤逦」。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_liu_1",
              "book": "唐圭璋《全宋词》",
              "edition": "中华书局校订本（通行本）",
              "page": "卷次与页码待核实",
              "url": "https://ctext.org/wiki.pl?if=gb&chapter=762233",
              "note": "网络校对据「子夜星分站·宋柳永词全集·卷三」；正式引用前请核对纸本页码",
              "verified": "verified"
            }
          ],
          "createdAt": "2026-01-01T00:00:00.000Z",
          "updatedAt": "2026-01-01T00:00:00.000Z"
        },
        {
          "id": "cl_seed_liu_3_b",
          "kind": "pending",
          "text": "三阕是否确为同一组词、同一作期，待考。",
          "paragraph": -1,
          "citations": [
            {
              "id": "ct_seed_liu_1",
